{
  "THEME": {
    "mode": "dark",
    "allowThemeToggle": true,
    "accent": "#36D6D0",
    "background": "#0B1014",
    "surface": "#121B22",
    "text": "#E8F0F2",
    "mutedText": "#91A3AD"
  },
  "NAVIGATION": {
    "sections": [
      "HOME",
      "ABOUT",
      "EDUCATION",
      "SKILLS",
      "PROJECTS",
      "MEMBERSHIPS",
      "LANGUAGES",
      "CONTACT",
      "CV_BUILDER"
    ],
    "sticky": true,
    "mobileMenu": true
  },
  "ANIMATIONS": {
    "enabled": true,
    "motionLevel": "subtle",
    "respectReducedMotion": true
  },
  "LOADING_SCREEN": {
    "enabled": true,
    "durationMs": 1800,
    "messages": [
      "Initializing robotics portfolio...",
      "Loading engineering profile...",
      "Preparing project systems...",
      "Portfolio ready."
    ],
    "cursor": "_"
  },
  "BRANDING": {
    "logo": "assets/imgs/logo.webp",
    "profileImage": "assets/imgs/pfp.jpg",
    "pageTitleSuffix": " | Robotics & Embedded Systems"
  },
  "ACADEMIC_DATA": {
    "provider": "googleSheetsPublishedCsv",
    "spreadsheetId": "1IyFfYOmqpVw5fxjIpJbE31UIo5f2qS7g6j6hbJhichQ",
    "fields": {
      "BTech": {
        "sheet": "BTech",
        "cell": "K7",
        "target": "EDUCATION[0].cgpa",
        "format": "number",
        "displayPrecision": 2
      }
    },
    "refreshIntervalMinutes": 30,
    "cacheLastValidValue": true,
    "showLastUpdated": true,
    "publicDataOnly": true
  },
  "AI": {
    "enabled": false,
    "provider": "configureBeforeUse",
    "endpoint": "",
    "model": "",
    "apiKeyEnvironmentVariable": "AI_API_KEY",
    "neverExposeApiKeyInBrowser": true,
    "generation": {
      "shortDescription": {
        "enabled": false,
        "source": [
          "PROFILE.about-me",
          "PROFILE.name",
          "PROFILE.title",
          "EDUCATION",
          "SKILLS",
          "PROJECTS",
          "MEMBERSHIPS",
          "LANGUAGES"
        ],
        "targetWordCount": {
          "min": 50,
          "max": 60
        },
        "cache": true,
        "fallbackToLastValid": true
      },
      "portfolioSummary": {
        "enabled": false,
        "source": [
          "PROFILE.about-me",
          "EDUCATION",
          "SKILLS",
          "PROJECTS",
          "MEMBERSHIPS"
        ],
        "cache": true,
        "fallbackToLastValid": true
      },
      "cv": {
        "enabled": false,
        "jobRolePromptRequired": true,
        "preserveVerifiedFactsOnly": true,
        "allowUserToContinueAfterMismatchWarning": false,
        "showJobFitAssessment": true,
        "jobFitOutcomes": [
          "PASS",
          "FAIL",
          "UNKNOWN"
        ],
        "generateJobSpecificSummary": true,
        "previewBeforeExport": true,
        "exportFormat": [
          "pdf"
        ],
        "layout": "twoColumn",
        "onePagePreferred": true
      }
    }
  },
  "DATA_SYNC": {
    "github": {
      "enabled": false,
      "refreshIntervalMinutes": 60,
      "publicDataOnly": true
    },
    "failureBehavior": "retainLastValidData"
  },
  "PORTFOLIO": {
    "shortDescriptionSource": "PROFILE.short-description",
    "aboutMeSource": "PROFILE.about-me",
    "projectStatusLabels": [
      "PLANNED",
      "IN_PROGRESS",
      "COMPLETED",
      "ON_HOLD"
    ],
    "showLastUpdated": true
  },
  "CV": {
    "enabled": true,
    "defaultMode": "quick",
    "modes": {
      "quick": {
        "enabled": true,
        "jobDescriptionRequired": false,
        "targetRoleRequired": false,
        "useVerifiedProfileData": true,
        "allowPreview": true,
        "allowPdfExport": true
      },
      "detailed": {
        "enabled": true,
        "jobDescriptionRequired": true,
        "targetRoleRequired": true,
        "extractRequirements": true,
        "reviewExtractedRequirements": true,
        "preserveOriginalJobDescription": true,
        "classifyRequirements": [
          "MANDATORY",
          "PREFERRED",
          "AMBIGUOUS"
        ],
        "verifyAgainstProfileEvidence": true,
        "allowManualEvidenceReview": true,
        "allowRequirementCorrection": true,
        "blockGenerationOnMandatoryFail": true,
        "blockGenerationOnMandatoryUnknown": true,
        "allowPreviewBeforeEligibilityPass": false,
        "allowPdfExportBeforeEligibilityPass": false
      }
    },
    "template": "tealTwoColumn",
    "headerAccent": "#178C8C",
    "pageSize": "A4",
    "onePagePreferred": true,
    "allowPreview": true,
    "allowPdfExport": true,
    "eligibility": {
      "enabled": true,
      "outcomes": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ],
      "mandatoryRequirementsMustPass": true,
      "unknownEvidenceMustNotCountAsPass": true,
      "preferredRequirementsCanAffectRanking": true,
      "ambiguousRequirementsRequireReview": true,
      "keywordOverlapIsNotProof": true,
      "requireEvidenceForQualificationClaims": true,
      "neverInventQualifications": true,
      "neverInventWorkExperience": true,
      "neverInventProjectResults": true,
      "neverInventAcademicScores": true,
      "neverInventCertifications": true,
      "neverInventProjectUrls": true
    },
    "matching": {
      "enabled": true,
      "matchOnlySupportedSkills": true,
      "prioritizeRelevantProjects": true,
      "reorderExistingContent": true,
      "allowRoleSpecificSummary": true,
      "preserveVerifiedFactsOnly": true,
      "doNotCreateMissingExperience": true,
      "doNotInferEligibilityFromKeywordsAlone": true
    },
    "preview": {
      "requireEligibilityPassInDetailedMode": true,
      "showRelevantSkills": true,
      "showRelevantProjects": true,
      "showEducation": true,
      "showExperienceOnlyWhenAvailable": true,
      "hideEmptySections": true
    },
    "export": {
      "format": "pdf",
      "method": "browserPrint",
      "requireEligibilityPassInDetailedMode": true,
      "requirePreview": true
    }
  },
  "ACCESSIBILITY": {
    "respectReducedMotion": true,
    "keyboardAccessible": true,
    "visibleFocus": true
  },
  "PERFORMANCE": {
    "lazyLoadImages": true,
    "cacheGeneratedContent": true,
    "avoidUnnecessaryApiCalls": true
  }
}